# ============================================================
# PARQUEADERO SGP-8 - PLANTILLA DE CONFIGURACION
# ============================================================
# Copia este archivo como .env y rellena tus datos reales.
# El archivo .env NO debe subirse a GitHub.
# ============================================================

# Conexion a PostgreSQL en Aiven
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE_DE_DATOS?sslmode=require
DATABASE_URL="postgresql://avnadmin:TU_CLAVE_AQUI@TU_HOST.aivencloud.com:TU_PUERTO/defaultdb?sslmode=require"

# Reglas de negocio
PRECIO_CARRO=3000
PRECIO_MOTO=1500
TOTAL_CELDAS=8

# Servidor local
APP_HOST="127.0.0.1"
APP_PORT=8000

# Zona horaria para reportes y liquidacion
ZONA_HORARIA="America/Bogota"
